package virtiofs

import (
	"log"
	"net"

	"github.com/hanwen/go-fuse/v2/fuse"
	"github.com/hanwen/go-fuse/v2/internal/vhostuser"
)

// ServeFS connects a FUSE filesystem to a virtio-fs device over a vhost-user
// socket.
//
// This adapter does not implement the optional Virtio notification queue, and
// the supported Linux guest driver does not negotiate it. Unsolicited FUSE
// notifications therefore return ENOSYS here. Directory caches can still use
// FUSE_AUTO_INVAL_DATA with versioned mtimes and attribute revalidation.
func ServeFS(sockpath string, rawFS fuse.RawFileSystem, opts *fuse.MountOptions) {
	l, err := net.ListenUnix("unix", &net.UnixAddr{Name: sockpath, Net: "unix"})
	if err != nil {
		log.Fatal("Listen", err)
	}

	opts.DisableSplice = true
	ps := fuse.NewProtocolServer(rawFS, opts)
	for {
		conn, err := l.AcceptUnix()
		if err != nil {
			break
		}

		dev := vhostuser.NewDevice(func(vqe *vhostuser.VirtqElem) int {
			n, _ := ps.HandleScatter(vqe.Read, vqe.Write)
			return n
		})
		//dev.Debug = true
		srv := vhostuser.NewServer(conn, dev)
		srv.Debug = false
		if err := srv.Serve(); err != nil {
			log.Printf("Serve: %v %T", err, err)
		}

		srv.Close()
	}
}
