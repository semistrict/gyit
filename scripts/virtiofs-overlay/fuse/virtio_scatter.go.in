package fuse

// HandleScatter accepts descriptor boundaries chosen by the guest. Linux can
// split a single READ payload across many pages; those boundaries are not the
// protocol's fixed-header/payload boundaries expected by HandleRequest.
func (ps *ProtocolServer) HandleScatter(in, out [][]byte) (int, Status) {
	// The benchmark negotiates ordinary FUSE I/O sizes. Reject unreasonable
	// chains before allocating memory, including integer-overflowing sums.
	const limit = 16 << 20
	size := func(parts [][]byte) int {
		n := 0
		for _, p := range parts {
			if len(p) > limit-n {
				return -1
			}
			n += len(p)
		}
		return n
	}
	ni, no := size(in), size(out)
	if ni < 0 || no < 0 {
		return 0, EIO
	}
	request, response := make([]byte, ni), make([]byte, no)
	offset := 0
	for _, p := range in {
		offset += copy(request[offset:], p)
	}
	n, status := ps.HandleFlat(request, response)
	if status != OK {
		return 0, status
	}
	offset = 0
	for _, p := range out {
		offset += copy(p, response[offset:n])
		if offset == n {
			break
		}
	}
	return n, OK
}
